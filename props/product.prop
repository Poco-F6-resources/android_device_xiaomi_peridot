# App launch prefetching (IORapd)
ro.iorapd.enable=false
iorapd.perfetto.enable=false
iorapd.readahead.enable=false
persist.device_config.runtime_native_boot.iorap_readahead_enable=false

# Audio
audio.offload.min.duration.secs=30

# Bluetooth
bluetooth.auto_connect_profiles.enabled=true
bluetooth.device_id.vendor_id=0x001D
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.avrcp.controller.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bap.broadcast.assist.enabled=false
bluetooth.profile.bap.broadcast.source.enabled=false
bluetooth.profile.bap.unicast.client.enabled=false
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.ccp.server.enabled=false
bluetooth.profile.csip.set_coordinator.enabled=false
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hap.client.enabled=false
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=false
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.mcp.server.enabled=false
bluetooth.profile.opp.enabled=true
bluetooth.profile.pbap.server.enabled=true
bluetooth.profile.vcp.controller.enabled=false

# Media
media.stagefright.audio.deep=true

# RKPD
remote_provisioning.enable_rkpd=true
remote_provisioning.hostname=remoteprovisioning.googleapis.com

# LMK
ro.lmk.log_stats=false
ro.lmk.debug=false
ro.lmk.use_psi=true
ro.lmk.use_minfree_levels=false
ro.lmk.use_new_strategy=true
ro.lmk.low=1280
ro.lmk.medium=1024 
ro.lmk.critical=768
ro.lmk.critical_upgrade=false
ro.lmk.upgrade_pressure=80
ro.lmk.downgrade_pressure=30
ro.lmk.kill_heaviest_task=true
ro.lmk.kill_timeout_ms=200
ro.lmk.psi_partial_stall_ms=600   
ro.lmk.psi_complete_stall_ms=1000
ro.lmk.thrashing_limit=110
ro.lmk.thrashing_limit_decay=15
ro.lmk.swap_util_max=90
ro.lmk.swap_free_low_percentage=10
ro.lmk.filecache_min_kb=65536
ro.lmk.stall_limit_critical=5
ro.config.low_ram=false
ro.config.per_app_memcg=true