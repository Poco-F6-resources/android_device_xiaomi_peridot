allow hal_power_default proc_walt:dir search;
allow hal_power_default proc_walt:file rw_file_perms;
allow hal_power_default vendor_sysfs_msm_perf:file rw_file_perms;

# Allow libperfmgr to write on /proc & sysfs
allow hal_power_default sysfs:file rw_file_perms;
allow hal_power_default sysfs:file open;
allow hal_power_default sysfs_gpu:file { read write open };

# Allow power HAL access to thermal sysfs nodes
rw_dir_file(hal_power_default, sysfs_therm)

allow hal_power_default sysfs_gpu:dir { search };
allow hal_power_default fwk_stats_service:service_manager find;
allow hal_power_default hal_thermal_default:binder { call transfer };

# Additional rule for sysfs CPU nodes
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;

# To get/set powerhal state property
set_prop(hal_power_default, vendor_power_prop)

r_dir_file(hal_power_default, input_device)

allow hal_power_default {
  vendor_sysfs_devfreq
  sysfs_msm_subsys
  sysfs_thermal
}:dir search;

allow hal_power_default {
  input_device
  vendor_latency_device
}:chr_file rw_file_perms;

allow hal_power_default {
  cgroup
  proc
  sysfs_devices_system_cpu
  vendor_sysfs_devfreq
  vendor_sysfs_graphics
  vendor_sysfs_kgsl
  vendor_sysfs_scsi_host
  sysfs_thermal
}:{
  file
  lnk_file
} rw_file_perms;

allow hal_power_default {
  cgroup
  input_device
  vendor_sysfs_devfreq
}:dir r_dir_perms;

# Thermal
rw_dir_file(hal_power_default, sysfs_thermal)

# Allow access to powercap directory
allow hal_thermal_default sysfs_thermal:dir { read open getattr search };
allow hal_thermal_default sysfs_thermal:file { read open getattr };
allow hal_power_default sysfs_thermal:lnk_file r_file_perms;

# Do not audit dac_override capability
dontaudit hal_power_default self:capability dac_override;

# Allow access to latency device for CPU DMA latency
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;
allow hal_power_default vendor_latency_device:chr_file ioctl;
allow hal_power_default self:capability sys_admin;

dontaudit hal_power_default self:capability dac_override;

# Rule for hal_power_default to access graphics composer process
unix_socket_connect(hal_power_default, vendor_pps, hal_graphics_composer_default);

# Allow powerHal to access certain app scopes
typeattribute hal_power_default mlstrustedsubject;

# Allow hal_power_default to access various sysfs and proc nodes
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;
allow hal_power_default proc_stat:file r_file_perms;
allow hal_power_default sysfs:file rw_file_perms;
allow hal_power_default sysfs:file open;

allow hal_power_default self:capability sys_nice;
allow hal_power_default self:capability sys_admin;
allow hal_power_default { appdomain -isolated_app_all -ephemeral_app }:process { getsched setsched };
allow hal_power_default platform_app_all:process { getsched setsched };
allow hal_power_default priv_app_all:process { getsched setsched };
allow hal_power_default system_app:process { getsched setsched };
allow hal_power_default surfaceflinger:process { getsched setsched };
allow hal_power_default mediacodec:process { getsched setsched };

# Allow powerhal to read cgroup
r_dir_file(hal_power_default, appdomain)
r_dir_file(hal_power_default, surfaceflinger)
r_dir_file(hal_power_default, system_server)

# Allow powerHal to access input device files
r_dir_file(hal_power_default, input_device)

# Allow powerHal to access latency services
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;
allow hal_power_default vendor_latency_device:chr_file ioctl;
allow hal_power_default touchfeature_device:chr_file { ioctl open read write };

# Allow powerHal to access graphics composer process
unix_socket_connect(hal_power_default, vendor_pps, hal_graphics_composer_default);

# Allow powerhal to access file R/W for sysfs thermal
rw_dir_file(hal_power_default, sysfs_thermal)

# Allow rw to devSDA
allow hal_power_default vendor_sysfs_sd:file rw_file_perms;
allow hal_power_default vendor_sysfs_sd:dir search;

# Allow powerHAL to access gpu
allow hal_power_default sysfs_gpu:file { read write open };
allow hal_power_default sysfs_gpu:dir { search };
allow hal_power_default fwk_stats_service:service_manager find;
binder_call(hal_power_default, stats_service_server);

# other rules
allow hal_power_default platform_app:process { getsched setsched };
allow hal_power_default priv_app:process { getsched setsched };
allow hal_power_default priv_app_36:process { getsched setsched };
allow hal_power_default mlstrustedsubject:process { getsched setsched };
